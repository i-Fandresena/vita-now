{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    // `src` et non `.` : avec la racine au dossier du projet, `tsc` reproduit
    // l'arborescence et écrit dans `dist/src/index.js`. Le service systemd et
    // le script `start` pointent vers `dist/index.js` — le service refusait
    // donc de démarrer, avec un « Cannot find module » qui n'oriente vers
    // rien. Le typecheck ne peut pas voir ce genre d'écart : il faut avoir
    // lancé le binaire construit.
    "rootDir": "src",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
