# VITA'NOW — API
#
# Copier en `.env` et renseigner. Ce fichier-ci est versionné, `.env` ne l'est
# jamais (voir .gitignore à la racine).

# Connexion PostgreSQL.
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/vitanow

# Port d'écoute de l'API. Nginx fait le reverse proxy de /api/ vers ce port.
PORT=3000

# Origine autorisée pour les requêtes du navigateur.
# En production : https://vitanow.aura-plus.site
CORS_ORIGIN=http://localhost:5173

# Secret de signature des cookies de session.
# En générer un vrai : openssl rand -hex 32
COOKIE_SECRET=changer-cette-valeur-avant-toute-mise-en-ligne

# Clé API Claude — utilisée uniquement pour le résumé de projet (M5).
# L'API démarre sans : le résumé est alors déduit du journal par règles.
ANTHROPIC_API_KEY=

# Clé API Gemini — préférée à Claude pour le résumé de projet si présente
# (modèle "gemini-flash-latest", "gemini-2.0-flash" a un quota gratuit à 0
# sur ce projet). L'API démarre sans : repli sur Claude puis sur les règles.
GEMINI_API_KEY=

# OAuth Google (console.cloud.google.com > API et services > Identifiants).
# URI de redirection à enregistrer côté Google : {GOOGLE_REDIRECT_URI}.
# Vides = bouton « Google » désactivé sur les écrans de connexion/inscription.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# OAuth GitHub (github.com/settings/developers > OAuth Apps).
# Le scope user:email est demandé par l'application pour vérifier l'adresse.
# URI de redirection à enregistrer côté GitHub : {GITHUB_REDIRECT_URI}.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
