# VITA'NOW — API
#
# Copier en `.env` et renseigner. Ce fichier-ci est versionné, `.env` ne l'est
# jamais (voir .gitignore à la racine).

# Connexion PostgreSQL.
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/vitanow

# Port d'écoute de l'API. Nginx fait le reverse proxy de /api/ vers ce port.
PORT=3000

# Origine autorisée pour les requêtes du navigateur.
# En production : https://aura.icpp-conformite.cloud
CORS_ORIGIN=http://localhost:5173

# Secret de signature des cookies de session.
# En générer un vrai : openssl rand -hex 32
COOKIE_SECRET=changer-cette-valeur-avant-toute-mise-en-ligne

# Clé API Claude — utilisée uniquement pour le résumé de projet (M5).
# L'API démarre sans : le résumé est alors déduit du journal par règles.
ANTHROPIC_API_KEY=
